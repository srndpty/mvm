# Build output
/build/
/out/
/staging/
/install/

# CMake user files
CMakeUserPresets.json

# Generated test media (regenerate with scripts/make-testmedia.ps1)
#
# **ディレクトリごと除外しない。** 除外すると git が中へ降りないので、
# 個別の否定パターン (!) が効かなくなる。中身を除外して例外を作る。
/tests/assets/*

# color correctness の fixture は **追跡する** (P1.2 §5)。
# 生成物ではあるが全部で 25KB 程度しかなく、無いと color test が
# 「黙って未登録」になり、clean checkout で色検査が消える。
# 必ず検査させるためリポジトリに入れる。
# manifest.txt は C++ 側が読む行指向の版 (JSON parser を足さないため)。
!/tests/assets/color/
!/tests/assets/p2_compositor/

# Frozen MSYS2 packages: large binaries, kept on disk for reproducible
# rebuilds but not committed. docs/deps-lock.txt is the committed record.
/third_party/pkgs/*
!/third_party/pkgs/README.md

# Benchmark resultsはcommitし、scratchと巨大なfull dumpだけを追跡しない
/bench/results/scratch/
/bench/results/**/*.dmp

# Editor / OS
.vs/
.idea/
*.user
Thumbs.db
desktop.ini
tmp/

# ablation の派生 scenario は build/<preset>/ablation/scenarios にだけ置く。
# 以前は bench/scenarios へ書いており、派生物が Git に入ってしまった。
bench/scenarios/abl-*.json

# CTest が repo root で実行されたときに作る runtime artifact。
# 成果物ではないので追跡しない (build tree 内の Testing/ は対象外)。
/Testing/
