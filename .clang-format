---
Language: Cpp
BasedOnStyle: LLVM
Standard: c++20
ColumnLimit: 100
IndentWidth: 4
TabWidth: 4
UseTab: Never
AccessModifierOffset: -4
PointerAlignment: Left
ReferenceAlignment: Left
AllowShortFunctionsOnASingleLine: Inline
AlwaysBreakTemplateDeclarations: Yes
BreakBeforeBraces: Attach
FixNamespaceComments: true
IncludeBlocks: Regroup
NamespaceIndentation: None
SeparateDefinitionBlocks: Always
SortIncludes: CaseSensitive
SpaceAfterTemplateKeyword: false
IncludeCategories:
  # Own headers first (paired header handled by clang-format automatically)
  - Regex: '^"'
    Priority: 10
  # MLT: only legal inside src/media/mlt/
  - Regex: '^<(framework|mlt)/'
    Priority: 40
  - Regex: '^<Q'
    Priority: 30
  # windows.h は他の Win32 ヘッダ (bcrypt.h 等) が前提にする型を定義するため、
  # 同じブロック内でも必ず先頭へ並べる。
  - Regex: '^<windows\.h>'
    Priority: 20
    SortPriority: 15
  - Regex: '^<'
    Priority: 20
