{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug (gdb, UCRT64)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
            "environment": [
                {
                    "//": "UCRT64 の DLL を確実に拾う。既存の他 Qt/DLL より前に置く。",
                    "name": "PATH",
                    "value": "C:/msys64/ucrt64/bin;${env:PATH}"
                }
            ],
            "setupCommands": [
                { "description": "pretty printing", "text": "-enable-pretty-printing", "ignoreFailures": true }
            ]
        }
    ]
}
