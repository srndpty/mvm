{
    "//": "mvm Phase 0: MSYS2 UCRT64 で統一する。既存の Qt 6.8.3 (MSVC) や pip 版 cmake を拾わないこと。",

    "cmake.cmakePath": "C:/msys64/ucrt64/bin/cmake.exe",
    "cmake.useCMakePresets": "always",
    "cmake.configureOnOpen": false,

    "//kits": "CMake Tools の kit 自動検出は VS の MSVC kit を拾うため無効化し、preset に一本化する。",
    "cmake.additionalKits": [],

    "C_Cpp.default.compileCommands": "${workspaceFolder}/build/ucrt64-debug/compile_commands.json",
    "C_Cpp.default.compilerPath": "C:/msys64/ucrt64/bin/g++.exe",
    "C_Cpp.default.cppStandard": "c++20",
    "C_Cpp.default.intelliSenseMode": "windows-gcc-x64",

    "files.encoding": "utf8",
    "files.eol": "\n",
    "[powershell]": { "files.eol": "\r\n" },

    "editor.formatOnSave": true,
    "C_Cpp.clang_format_path": "C:/msys64/ucrt64/bin/clang-format.exe",

    "terminal.integrated.profiles.windows": {
        "MSYS2 UCRT64": {
            "path": "C:/msys64/usr/bin/bash.exe",
            "args": ["--login", "-i"],
            "env": {
                "MSYSTEM": "UCRT64",
                "CHERE_INVOKING": "1"
            }
        }
    },
    "terminal.integrated.defaultProfile.windows": "MSYS2 UCRT64"
}
