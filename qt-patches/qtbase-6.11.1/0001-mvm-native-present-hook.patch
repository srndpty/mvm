+extern "C" Q_DECL_EXPORT std::uint32_t mvm_qt_d3d11_present_hook_abi_version()
+{
+    return MVM_NATIVE_PRESENT_HOOK_ABI_VERSION;
+}
+
+extern "C" Q_DECL_EXPORT int mvm_qt_d3d11_present_hook_begin(MvmNativePresentRing *ring)
+{
+    if (!ring || !mvmNativePresentHookLayoutCompatible(
+                ring->abiVersion, ring->capacity, ring->compositionTokenSize,
+                ring->presentRecordSize, ring->oneShotSnapshotSize,
+                ring->oneShotSnapshotLayoutSignature, ring->layoutSignature) || mvmPresentRing)
+        return 0;
+    const LONG64 captureEpoch = InterlockedIncrement64(&mvmCaptureEpochSerial);
+    if (captureEpoch <= 0)
+        return 0;
+    ring->enabled = 0;
+    ring->captureEpoch = static_cast<std::uint64_t>(captureEpoch);
+    ring->captureThreadId = GetCurrentThreadId();
+    ring->threadMismatchCount = 0;
+    ring->recordCount = 0;
+    ring->overflowCount = 0;
+    ring->missingTokenCount = 0;
+    ring->duplicateTokenCount = 0;
+    ring->staleTokenCount = 0;
+    ring->failedPresentCount = 0;
+    ring->missingFrameSwappedReceiptCount = 0;
+    ring->duplicateFrameSwappedReceiptCount = 0;
+    ring->staleFrameSwappedReceiptCount = 0;
+    ring->authorityFailure = 0;
+    ring->submissionMode = mvmSubmissionMode();
+    ring->configuredMaximumFrameLatency =
+            UINT(qMax(0, qEnvironmentVariableIntValue("QT_D3D_MAX_FRAME_LATENCY")));
+    ring->swapchainMaximumFrameLatency = 0;
+    ring->frameLatencyWaitableObjectAvailable = 0;
+    ring->dwmFlushCallCount = 0;
+    ring->dwmFlushFailureCount = 0;
+    mvmSwapChainDiagnosticsCaptured = false;
+    if (ring->submissionMode == MVM_SUBMISSION_MODE_DWM_FLUSH_AFTER_PRESENT) {
+        HMODULE dwmApi = LoadLibraryW(L"dwmapi.dll");
+        FARPROC dwmFlushProc = dwmApi ? GetProcAddress(dwmApi, "DwmFlush") : nullptr;
+        static_assert(sizeof(mvmDwmFlush) == sizeof(dwmFlushProc));
+        std::memcpy(&mvmDwmFlush, &dwmFlushProc, sizeof(mvmDwmFlush));
+        if (!mvmDwmFlush)
+            return 0;
+    } else {
+        mvmDwmFlush = nullptr;
+    }
+    mvmPendingToken = {};
+    mvmPendingTokenValid = false;
+    mvmFrameSwappedReceipt = {};
+    mvmFrameSwappedReceiptValid = false;
+    mvmPresentRing = ring;
+    ring->enabled = 1;
+    return 1;
+}
+
+extern "C" Q_DECL_EXPORT int mvm_qt_d3d11_present_hook_set_token(
+        const MvmNativePresentCompositionToken *token)
+{
+    MvmNativePresentRing *ring = mvmPresentRing;
+    if (!ring || ring->enabled == 0 || !token)
+        return 0;
+    if (ring->captureThreadId == 0 || ring->captureThreadId != GetCurrentThreadId()) {
+        ++ring->threadMismatchCount;
+        ring->authorityFailure = 1;
+        return 0;
+    }
+    if (mvmPendingTokenValid) {
+        ++ring->duplicateTokenCount;
+        ring->authorityFailure = 1;
+        return 0;
+    }
+    mvmPendingToken = *token;
+    mvmPendingTokenValid = true;
+    return 1;
+}
+
+extern "C" Q_DECL_EXPORT int mvm_qt_d3d11_present_hook_end()
+{
+    MvmNativePresentRing *ring = mvmPresentRing;
+    if (!ring || ring->enabled == 0)
+        return 0;
+    if (ring->captureThreadId == 0 || ring->captureThreadId != GetCurrentThreadId()) {
+        ++ring->threadMismatchCount;
+        ring->authorityFailure = 1;
+        return 0;
+    }
+    ring->enabled = 0;
+    if (mvmFrameSwappedReceiptValid) {
+        ++ring->staleFrameSwappedReceiptCount;
+        ring->authorityFailure = 1;
+        mvmFrameSwappedReceiptValid = false;
+    }
+    if (mvmPendingTokenValid) {
+        ++ring->staleTokenCount;
+        ring->authorityFailure = 1;
+        mvmPendingTokenValid = false;
+    }
+    mvmPresentRing = nullptr;
+    return 1;
+}
+
+extern "C" Q_DECL_EXPORT int mvm_qt_d3d11_present_hook_take_frame_swapped_receipt(
+        MvmNativePresentFrameSwappedReceipt *receipt)
+{
+    MvmNativePresentRing *ring = mvmPresentRing;
+    if (!ring || ring->enabled == 0 || !receipt || !mvmFrameSwappedReceiptValid) {
+        if (ring) {
+            ++ring->missingFrameSwappedReceiptCount;
+            ring->authorityFailure = 1;
+        }
+        return 0;
+    }
+    if (ring->captureThreadId == 0 || ring->captureThreadId != GetCurrentThreadId()) {
+        ++ring->threadMismatchCount;
+        ring->authorityFailure = 1;
+        return 0;
+    }
+    *receipt = mvmFrameSwappedReceipt;
+    mvmFrameSwappedReceipt = {};
+    mvmFrameSwappedReceiptValid = false;
+    return 1;
+}
+
+extern "C" Q_DECL_EXPORT int mvm_qt_d3d11_present_hook_one_shot_snapshot(
+        std::uint64_t expectedCaptureEpoch, MvmNativePresentOneShotSnapshot *snapshot)
+{
+    if (!snapshot || expectedCaptureEpoch == 0)
+        return MVM_ONE_SHOT_SNAPSHOT_INVALID_ARGUMENT;
+    if (!mvmNativePresentOneShotSnapshotLayoutCompatible(
+                snapshot->abiVersion, snapshot->snapshotSize, snapshot->layoutSignature))
+        return MVM_ONE_SHOT_SNAPSHOT_ABI_LAYOUT_MISMATCH;
+    MvmNativePresentRing *ring = mvmPresentRing;
+    if (!ring || ring->enabled == 0)
+        return MVM_ONE_SHOT_SNAPSHOT_CAPTURE_INACTIVE;
+    if (ring->captureEpoch != expectedCaptureEpoch)
+        return MVM_ONE_SHOT_SNAPSHOT_EPOCH_MISMATCH;
+    const std::uint32_t callerThreadId = GetCurrentThreadId();
+    if (ring->captureThreadId == 0 || ring->captureThreadId != callerThreadId)
+        return MVM_ONE_SHOT_SNAPSHOT_THREAD_MISMATCH;
+
+    MvmNativePresentOneShotSnapshot exact{};
+    exact.abiVersion = MVM_NATIVE_PRESENT_HOOK_ABI_VERSION;
+    exact.snapshotSize = sizeof(MvmNativePresentOneShotSnapshot);
+    exact.layoutSignature = mvmNativePresentOneShotSnapshotLayoutSignature();
+    exact.captureEpoch = ring->captureEpoch;
+    exact.captureActive = 1;
+    exact.captureThreadId = ring->captureThreadId;
+    exact.callerThreadId = callerThreadId;
+    exact.callerThreadExact = 1;
+    exact.pendingTokenValid = mvmPendingTokenValid ? 1U : 0U;
+    exact.pendingReceiptValid = mvmFrameSwappedReceiptValid ? 1U : 0U;
+    exact.pendingToken = mvmPendingToken;
+    exact.pendingReceipt = mvmFrameSwappedReceipt;
+    *snapshot = exact;
+    return MVM_ONE_SHOT_SNAPSHOT_OK;
+}
