 #include <QtCore/qcryptographichash.h>
 #include <QtCore/private/qsystemerror_p.h>
 #include "qrhid3dhelpers_p.h"
+#include <app/preview/native_present_hook_abi.h>
 
 #include <cstdio>
+#include <cstring>
 
+namespace {
+
+volatile LONG64 mvmCaptureEpochSerial = 0;
+MvmNativePresentRing *mvmPresentRing = nullptr;
+volatile LONG64 mvmPresentSerial = 0;
+thread_local MvmNativePresentCompositionToken mvmPendingToken{};
+thread_local bool mvmPendingTokenValid = false;
+thread_local MvmNativePresentFrameSwappedReceipt mvmFrameSwappedReceipt{};
+thread_local bool mvmFrameSwappedReceiptValid = false;
+using MvmDwmFlushFn = HRESULT (WINAPI *)();
+MvmDwmFlushFn mvmDwmFlush = nullptr;
+bool mvmSwapChainDiagnosticsCaptured = false;
+
+std::uint32_t mvmSubmissionMode()
+{
+    const QByteArray mode = qgetenv("MVM_P2_C3_SUBMISSION_MODE");
+    if (mode == "DWM_FLUSH_AFTER_PRESENT")
+        return MVM_SUBMISSION_MODE_DWM_FLUSH_AFTER_PRESENT;
+    if (mode == "FRAME_LATENCY_1")
+        return MVM_SUBMISSION_MODE_FRAME_LATENCY_1;
+    return MVM_SUBMISSION_MODE_CONTROL;
+}
+
+void mvmCaptureSwapChainDiagnostics(IDXGISwapChain *swapChain, MvmNativePresentRing *ring)
+{
+    if (!ring || mvmSwapChainDiagnosticsCaptured)
+        return;
+    mvmSwapChainDiagnosticsCaptured = true;
+    IDXGISwapChain1 *swapChain1 = nullptr;
+    if (SUCCEEDED(swapChain->QueryInterface(__uuidof(IDXGISwapChain1),
+                                            reinterpret_cast<void **>(&swapChain1)))) {
+        DXGI_SWAP_CHAIN_DESC1 desc{};
+        if (SUCCEEDED(swapChain1->GetDesc1(&desc))) {
+            ring->frameLatencyWaitableObjectAvailable =
+                    (desc.Flags & DXGI_SWAP_CHAIN_FLAG_FRAME_LATENCY_WAITABLE_OBJECT) != 0;
+        }
+        swapChain1->Release();
+    }
+    IDXGISwapChain2 *swapChain2 = nullptr;
+    if (SUCCEEDED(swapChain->QueryInterface(__uuidof(IDXGISwapChain2),
+                                            reinterpret_cast<void **>(&swapChain2)))) {
+        UINT latency = 0;
+        if (SUCCEEDED(swapChain2->GetMaximumFrameLatency(&latency)))
+            ring->swapchainMaximumFrameLatency = latency;
+        swapChain2->Release();
+    }
+}
+
+struct MvmPresentCapture {
+    MvmNativePresentRing *ring = nullptr;
+    MvmNativePresentRecord *record = nullptr;
+};
+
+MvmPresentCapture mvmBeginPresentCapture(IDXGISwapChain *swapChain, UINT syncInterval,
+                                         UINT presentFlags)
+{
+    MvmNativePresentRing *ring = mvmPresentRing;
+    if (!ring || ring->enabled == 0)
+        return {};
+    if (ring->captureThreadId == 0 || ring->captureThreadId != GetCurrentThreadId()) {
+        ++ring->threadMismatchCount;
+        ring->authorityFailure = 1;
+        return { ring, nullptr };
+    }
+    mvmCaptureSwapChainDiagnostics(swapChain, ring);
+    if (ring->recordCount >= ring->capacity) {
+        ++ring->overflowCount;
+        ring->authorityFailure = 1;
+        mvmPendingTokenValid = false;
+        return { ring, nullptr };
+    }
+    MvmNativePresentRecord *record = &ring->records[ring->recordCount];
+    *record = {};
+    record->presentSerial = static_cast<std::uint64_t>(InterlockedIncrement64(&mvmPresentSerial));
+    record->swapchainIdentity = reinterpret_cast<std::uint64_t>(swapChain);
+    record->threadId = GetCurrentThreadId();
+    record->syncInterval = syncInterval;
+    record->presentFlags = presentFlags;
+    LARGE_INTEGER enter{};
+    QueryPerformanceCounter(&enter);
+    record->presentEnterQpc = enter.QuadPart;
+    if (mvmPendingTokenValid) {
+        record->tokenPresent = 1;
+        record->token = mvmPendingToken;
+        record->intentOrdinal = mvmPendingToken.intentOrdinal;
+        record->intentOrdinalValid = mvmPendingToken.intentOrdinalValid;
+        mvmPendingTokenValid = false;
+    } else {
+        ++ring->missingTokenCount;
+        ring->authorityFailure = 1;
+    }
+    return { ring, record };
+}
+
+void mvmEndPresentCapture(MvmPresentCapture capture, HRESULT result)
+{
+    if (!capture.ring || !capture.record)
+        return;
+    LARGE_INTEGER returned{};
+    QueryPerformanceCounter(&returned);
+    capture.record->presentReturnQpc = returned.QuadPart;
+    capture.record->hresult = static_cast<std::int32_t>(result);
+    if (mvmFrameSwappedReceiptValid) {
+        ++capture.ring->duplicateFrameSwappedReceiptCount;
+        capture.ring->authorityFailure = 1;
+    }
+    mvmFrameSwappedReceipt = {};
+    mvmFrameSwappedReceipt.presentSerial = capture.record->presentSerial;
+    mvmFrameSwappedReceipt.swapchainIdentity = capture.record->swapchainIdentity;
+    mvmFrameSwappedReceipt.hresult = capture.record->hresult;
+    mvmFrameSwappedReceipt.tokenPresent = capture.record->tokenPresent;
+    mvmFrameSwappedReceipt.tokenSerial = capture.record->token.tokenSerial;
+    mvmFrameSwappedReceipt.intentOrdinal = capture.record->intentOrdinal;
+    mvmFrameSwappedReceipt.intentOrdinalValid = capture.record->intentOrdinalValid;
+    mvmFrameSwappedReceiptValid = true;
+    if (FAILED(result)) {
+        ++capture.ring->failedPresentCount;
+        capture.ring->authorityFailure = 1;
+    }
+    if (SUCCEEDED(result)
+        && capture.ring->submissionMode == MVM_SUBMISSION_MODE_DWM_FLUSH_AFTER_PRESENT) {
+        ++capture.ring->dwmFlushCallCount;
+        if (!mvmDwmFlush || FAILED(mvmDwmFlush())) {
+            ++capture.ring->dwmFlushFailureCount;
+            capture.ring->authorityFailure = 1;
+        }
+    }
+    ++capture.ring->recordCount;
+}
+
