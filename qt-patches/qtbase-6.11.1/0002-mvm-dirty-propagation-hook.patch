+std::uint64_t mvmRecordDirtyPropagationStage(std::uint32_t stage, std::uint64_t serial)
+{
+    MvmNativePresentRing *ring = mvmPresentRing;
+    if (!ring || ring->enabled == 0 || stage >= MVM_DIRTY_STAGE_COUNT)
+        return 0;
+    if (stage == MVM_DIRTY_STAGE_RENDERER_UPDATE && serial == 0)
+        serial = static_cast<std::uint64_t>(InterlockedIncrement64(&mvmPropagationSerial));
+    if (serial == 0)
+        serial = mvmCurrentPropagationSerial;
+    if (serial == 0)
+        return 0;
+    if (stage == MVM_DIRTY_STAGE_NODE_RENDER)
+        mvmCurrentPropagationSerial = serial;
+    const std::uint64_t index = serial - 1;
+    if (index >= ring->capacity) {
+        ++ring->dirtyPropagationOverflowCount;
+        ring->authorityFailure = 1;
+        return 0;
+    }
+    MvmDirtyPropagationRecord *record = &ring->dirtyPropagationRecords[index];
+    if (record->propagationSerial == 0) {
+        record->propagationSerial = serial;
+        ring->dirtyPropagationRecordCount = qMax(
+                ring->dirtyPropagationRecordCount, static_cast<std::uint32_t>(index + 1));
+    } else if (record->propagationSerial != serial) {
+        ++ring->dirtyPropagationOverflowCount;
+        ring->authorityFailure = 1;
+        return 0;
+    }
+    if (record->stageQpc[stage] != 0) {
+        ++ring->dirtyPropagationDuplicateStageCount;
+        ring->authorityFailure = 1;
+        return serial;
+    }
+    LARGE_INTEGER now{};
+    QueryPerformanceCounter(&now);
+    record->stageQpc[stage] = now.QuadPart;
+    ++ring->dirtyPropagationStageCounts[stage];
+    return serial;
+}
